{
  "autoCompactWindow": 332500,
  "enableArtifact": false,
  "skillOverrides": {
    "update-config": "user-invocable-only"
  },
  "permissions": {
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "ShowOnboardingRolePicker",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "mcp__ccd_session__*",
      "mcp__claude-code-remote__subscribe_pr_activity"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/слова_власника.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-code-remote__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/листи_менеджерові.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/фонові_завдання.py\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-code-remote__send_later|mcp__claude-code-remote__create_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/обіцянка_без_дії.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ]
  }
}
