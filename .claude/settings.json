{
  "autoCompactWindow": 250000,
  "enableArtifact": false,
  "permissions": {
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "ShowOnboardingRolePicker",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "mcp__ccd_session__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/слова_власника.py\""
          }
        ]
      }
    ]
  }
}
