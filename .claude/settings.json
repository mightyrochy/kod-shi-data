{
  "autoCompactWindow": 332500,
  "enableArtifact": false,
  "skillOverrides": {
    "update-config": "user-invocable-only",
    "session-start-hook": "off",
    "dataviz": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "run": "off",
    "plugin-authoring": "off",
    "init": "off",
    "security-review": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "permissions": {
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "ShowOnboardingRolePicker",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "mcp__ccd_session__*",
      "mcp__claude-code-remote__subscribe_pr_activity"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/слова_власника.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-code-remote__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/листи_менеджерові.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/фонові_завдання.py\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-code-remote__send_later|mcp__claude-code-remote__create_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/обіцянка_без_дії.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ]
  }
}
