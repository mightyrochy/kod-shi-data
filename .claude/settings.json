{
  "autoCompactWindow": 332500,
  "enableArtifact": false,
  "skillOverrides": {
    "update-config": "user-invocable-only"
  },
  "permissions": {
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "ShowOnboardingRolePicker",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "mcp__ccd_session__*",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "AskUserQuestion",
      "DesignSync",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "ListConnectors",
      "ListMcpResourcesTool",
      "ListPlugins",
      "ListSkills",
      "McpTaskCheck",
      "McpTaskResumePolling",
      "McpTaskShowQuestion",
      "NotebookEdit",
      "PushNotification",
      "ReadMcpResourceDirTool",
      "ReadMcpResourceTool",
      "SearchMcpRegistry",
      "SearchSkills",
      "SuggestConnectors",
      "TaskCreate",
      "TaskUpdate",
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__*",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__confirm_repository_trust",
      "mcp__claude-code-remote__create_environment",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__list_computer_folders",
      "mcp__claude-code-remote__list_environments",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__request_computer_folder",
      "mcp__claude-code-remote__request_credential",
      "mcp__claude-code-remote__switch_environment",
      "mcp__claude-code-remote__unwatch_url",
      "mcp__claude-code-remote__update_environment",
      "mcp__claude-code-remote__watch_url",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__disable_pr_auto_merge",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/слова_власника.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-code-remote__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/листи_менеджерові.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/фонові_завдання.py\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-code-remote__send_later|mcp__claude-code-remote__create_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/прийом_менеджера.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/обіцянка_без_дії.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/хуки/дотримання_диспетчера.py\""
          }
        ]
      }
    ]
  }
}
