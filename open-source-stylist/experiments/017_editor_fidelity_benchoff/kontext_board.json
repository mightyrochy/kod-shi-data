{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "flux1-dev-kontext_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "DualCLIPLoader", "inputs": {"clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp16.safetensors", "type": "flux"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "ae.safetensors"}},

  "4": {"class_type": "LoadImage", "inputs": {"image": "e016_person.png"}},
  "5": {"class_type": "LoadImage", "inputs": {"image": "e016_board.png"}},

  "6": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["4", 0]}},
  "7": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["5", 0]}},

  "8": {"class_type": "VAEEncode", "inputs": {"pixels": ["6", 0], "vae": ["3", 0]}},
  "9": {"class_type": "VAEEncode", "inputs": {"pixels": ["7", 0], "vae": ["3", 0]}},

  "10": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "Keep the same person: identical face, hair, skin, and body proportions. Keep the same pose and the same background. Replace only the clothing - dress this person in the complete outfit shown in the reference image. Take every garment's exact colour, texture and detail from the reference."}},
  "11": {"class_type": "FluxGuidance", "inputs": {"conditioning": ["10", 0], "guidance": 2.5}},
  "12": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["11", 0], "latent": ["8", 0]}},
  "13": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["12", 0], "latent": ["9", 0]}},

  "14": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["10", 0]}},

  "15": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "seed": 42, "steps": 20, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["13", 0], "negative": ["14", 0], "latent_image": ["8", 0], "denoise": 1.0}},

  "16": {"class_type": "VAEDecode", "inputs": {"samples": ["15", 0], "vae": ["3", 0]}},
  "17": {"class_type": "SaveImage", "inputs": {"images": ["16", 0], "filename_prefix": "kontext_e017"}}
}
