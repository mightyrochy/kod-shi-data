# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Models (large binary files)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.ggml
*.fp8
*.q4_0
*.q4_1
*.q8_0

# Generated images and video — exclude by default
runs/*/output/
runs/*/outputs/
runs/*/repair/*/outputs/
runs/*/experiments/*/outputs/
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.gif

# Un-ignore intentional tracked images
# legacy runs: input and reference images
!runs/*/input/*.png
!runs/*/input/*.jpg
!runs/*/input/*.jpeg
!runs/*/input/*.webp
!runs/*/references/*.png
!runs/*/references/*.jpg
!runs/*/references/*.jpeg
!runs/*/references/*.webp

# experiments: un-ignore the folders themselves first, then their images
!runs/experiments/
!runs/experiments/input/
!runs/experiments/input/*.png
!runs/experiments/input/*.jpg
!runs/experiments/input/*.jpeg
!runs/experiments/input/*.webp
!runs/experiments/v1alpha/
!runs/experiments/v1alpha/*/
!runs/experiments/v1alpha/*/input/
!runs/experiments/v1alpha/*/input/*.png
!runs/experiments/v1alpha/*/input/*.jpg
!runs/experiments/v1alpha/*/input/*.jpeg
!runs/experiments/v1alpha/*/input/*.webp
!runs/experiments/v1alpha/*/output/
!runs/experiments/v1alpha/*/output/*.png
!runs/experiments/v1alpha/*/output/*.jpg

# ComfyUI temp
ComfyUI/temp/
ComfyUI/output/
ComfyUI/input/
*.comfy_temp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Secrets / local config
.env
*.local
configs/pipeline.yaml
