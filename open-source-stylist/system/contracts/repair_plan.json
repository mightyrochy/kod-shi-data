{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair_plan",
  "title": "RepairPlan",
  "description": "Targeted repairs to apply to a failing generation result.",
  "type": "object",
  "required": ["schema_version", "repair_plan_id", "verdict_id", "repairs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "repair_plan_id": { "type": "string" },
    "verdict_id": { "type": "string" },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["region", "defect_type", "strategy"],
        "additionalProperties": false,
        "properties": {
          "region": { "type": "string" },
          "defect_type": {
            "type": "string",
            "enum": ["color_mismatch", "missing_item", "wrong_layering", "proportion_drift", "identity_drift", "other"]
          },
          "target": { "type": "string" },
          "reference_image_path": { "type": "string" },
          "strategy": {
            "type": "string",
            "enum": ["color_correction", "inpaint", "omnitry", "regenerate", "face_restore", "background_restore"]
          }
        }
      }
    }
  }
}
