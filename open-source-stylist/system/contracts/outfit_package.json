{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outfit_package",
  "title": "OutfitPackage",
  "description": "Outfit to dress the person in — items, reference images, and layering logic.",
  "type": "object",
  "required": ["schema_version", "outfit_id", "items", "layout_logic"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "outfit_id": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "type", "description", "reference_image_paths", "visibility_priority"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["top", "bottom", "shoes", "jacket", "dress", "accessory", "bag", "hat", "other"]
          },
          "description": { "type": "string" },
          "reference_image_paths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "visibility_priority": {
            "type": "integer",
            "minimum": 1,
            "description": "1 = highest priority (must be fully visible)"
          }
        }
      }
    },
    "layout_logic": {
      "type": "object",
      "required": ["layering_order"],
      "additionalProperties": false,
      "properties": {
        "layering_order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "item_ids from outermost to innermost"
        },
        "visibility_notes": { "type": "string" }
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
