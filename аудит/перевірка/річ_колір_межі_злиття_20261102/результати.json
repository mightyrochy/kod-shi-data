      "-c",
      "\nfrom pathlib import Path\nimport importlib.util, json, os\np = Path('джерела/лабораторія/колір_сім_ї_ребра.py')\nspec = importlib.util.spec_from_file_location('ребра_діагностика', p)\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\ntext = m.серіалізувати(m.породити())\nout = Path(os.environ['TEMP'])/'перевірка-злиття'\n(out/'ребра-породжено.json').write_text(text, encoding='utf-8', newline='\\n')\na = json.loads(m.ВИХІД.read_text(encoding='utf-8'))\nb = json.loads(text)\ndifferences = []\ndef compare(a,b,path=''):\n    if isinstance(a,dict) and isinstance(b,dict) and a.keys() == b.keys():\n        for k in a: compare(a[k],b[k],path+'/'+str(k))\n    elif isinstance(a,list) and isinstance(b,list) and len(a)==len(b):\n        for i,(x,y) in enumerate(zip(a,b)): compare(x,y,path+'/'+str(i))\n    elif a != b:\n        numerical = isinstance(a,(int,float)) and isinstance(b,(int,float))\n        differences.append({'шлях':path,'записано':a,'породжено':b,\n                            'абсолютна_різниця':abs(a-b) if numerical else None})\ncompare(a,b)\nsummary = {'різниць':len(differences),\n           'нечислових':sum(x['абсолютна_різниця'] is None for x in differences),\n           'найбільша_абсолютна_різниця':max((x['абсолютна_різниця'] or 0 for x in differences), default=0),\n           'різниці':differences}\n(out/'ребра-розбіжності.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2),encoding='utf-8')\nprint(json.dumps(summary,ensure_ascii=False))"
