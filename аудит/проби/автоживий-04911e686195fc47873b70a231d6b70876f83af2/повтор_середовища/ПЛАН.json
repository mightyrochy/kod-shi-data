  "cloud": {
    "ж9_вечеря_без_пальта": [
      {
        "pr": 3863,
        "question": "в аркуші «Коли й погода» при теплі нема поля «Реагенти на дорогах» → розмова → main 3fec844a: поле стоїть → так, поля нема"
      },
      {
        "pr": 3703,
        "question": "чи проходить сцена функції на переписаному екрані без нових червоних звірок стенда проти main → функція → з коду: стенд на збірці main 3ffdcb9c дає 14 зелених і 4 червоні звірки → ті самі 14 зелених, жодної нової червоної"
      }
    ],
    "ж1_кольори_повтор_профілі": [
      {
        "pr": 2814,
        "question": "чи діє повтор після збою, чи ізольована відповідь профілю А від Б і чи доступний повтор після нового читання та збою → функція в Chromium на зібраній сторінці з керованою відповіддю моделі й збоєм моста → ДО: стендове відтворення у паспорті Е2-текст-жінці, записаного прогону сцени немає → повтор застосовує кольори А, Б не отримує відповідь А, після нового збою кнопка повтору доступна."
      }
    ],
    "ж7_прогулянка_субота": [
      {
        "pr": 2814,
        "question": "чи повтор після збою зчитує кольори для профілю А, не застосовує відповідь А до Б і не блокує кнопку після нового запуску під час повтору? → функція → ДО: стенд показу до виправлення P2, кнопка повтору лишалась disabled; відтворення 11438 у перевірці #2814, відповідь А застосовувалась до Б → краще: повтор А працює, відповідь А не застосовується до Б, після нового запуску кнопка повтору доступна."
      }
    ],
    "ж2_помічниця_вітер_реагенти": [
      {
        "pr": 3319,
        "question": "плитки вітру й реагентів доходять у стан помічниці; ДО з коду: на 8f2627cd полів нема; краще — wind_band і road_salt у state.case.fields за плитками, без плиток — нема"
      }
    ],
    "ж7_опис_без_фото_речей": [
      {
        "pr": 4184,
        "question": "образ руки 1–2, чиї речі на картці з фото, а опису не дійшов жоден кадр, має під «Чому цей образ» рядок «опис без фото»; з кадрами й без фото на картці — нема → функція → — → рядок є лише там, де фото на картці є, а кадрів опису нема"
      }
    ]
  },
  "scenes": {
