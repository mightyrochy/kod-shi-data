--- /dev/null
+++ b/.github/workflows/zapysy.yml
@@ -0,0 +1,26 @@
+name: записи без накопичення
+on:
+  pull_request:
+    branches: [main]
+    paths:
+      - 'аудит/**'
+      - 'джерела/прилади/великі_записи.py'
+      - 'джерела/прилади/читачі_записів.py'
+      - 'джерела/прилади/записи_межа.json'
+permissions:
+  contents: read
+jobs:
+  zapysy:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.11'
+      - name: кінцеве дерево PR містить звіт і малі докази
+        env:
+          BASE: ${{ github.event.pull_request.base.sha }}
+        run: python джерела/прилади/великі_записи.py --база "$BASE"
