+            default { $case[3] }
+        }
+    }
+    Check "$($case[0]): $got" ($got -ceq $expected)
+    if ($got -eq 'DONE') { Check "$($case[0]): повний SHA origin" ($script:completed.Sha -ceq $script:remote) }
