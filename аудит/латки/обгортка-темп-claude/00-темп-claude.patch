+        Check 'стелі коду знають нові ключі' ($script:Ceil.ContainsKey('claude_pace') -and $script:Ceil.ContainsKey('claude_5h_reserve_percent') -and $script:Ceil.ContainsKey('claude_quota_fresh_minutes') -and $script:Defaults.claude_pace -eq 0)
+    }
+} finally { }
+if ($bad) { "ПІДСУМОК: ✗ $bad"; exit 1 }
+'ПІДСУМОК: ✗ 0'
+exit 0
