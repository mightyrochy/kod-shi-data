+# --- темп смуги Claude ---------------------------------------------------------------------------------------------
+
+function ConvertTo-UtcSeconds($Value) {
+    <# Час UTC із `quota-claude.json` (рядок «…Z» чи DateTime, залежно від ConvertFrom-Json) -> секунди Unix; не час — $null. #>
+    if ($Value -is [datetime]) { return [DateTimeOffset]::new($Value.ToUniversalTime()).ToUnixTimeSeconds() }
+    $t = [string]$Value
+    if ($t -notmatch '^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$') { return $null }
+    [DateTimeOffset]::ParseExact($t, "yyyy-MM-dd'T'HH:mm:ss'Z'", [cultureinfo]::InvariantCulture, [System.Globalization.DateTimeStyles]::AssumeUniversal).ToUnixTimeSeconds()
+}
+
+function Get-ClaudePace($Quota, $Limits, [long]$Now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()) {
+    <# Темп тижневого ліміту Claude з `quota-claude.json` (вікна 5H і 7D: залишок % і скидання, коли зчитано).
+
+    Бере нове, лише коли водночас: використано 7D не більше за рівний темп — частку тижня, що минула від (скидання − 7 діб),
+    а залишок 5H не менший за запас `claude_5h_reserve_percent` (координатори сесій — з того самого акаунта). Нема даних,
+    вони старші за `claude_quota_fresh_minutes` або вікно вже скинулось — Known=$false: нового не беремо, крім однієї
+    проби (Probe), що оновить `rate_limit_event`. Розпочаті наряди не зупиняються — це рішення лише про нові. #>
+    $r = [pscustomobject]@{ Known = $false; Take = $false; Probe = $true; Used7 = $null; Pace7 = $null; Left5 = $null; Why = 'нема свіжих даних' }
+    $fresh = 30; $reserve = 20
+    if ($null -ne $Limits -and $Limits.ContainsKey('claude_quota_fresh_minutes')) { $fresh = [double]$Limits['claude_quota_fresh_minutes'] }
+    if ($null -ne $Limits -and $Limits.ContainsKey('claude_5h_reserve_percent')) { $reserve = [double]$Limits['claude_5h_reserve_percent'] }
+    if ($null -eq $Quota) { return $r }
+    $read = ConvertTo-UtcSeconds (Get-JsonProp $Quota 'read')
+    if ($null -eq $read -or ($Now - $read) -gt 60 * $fresh -or $read -gt $Now + 300) { $r.Why = "дані старші за $fresh хв або без часу"; return $r }
+    $w7 = $null; $w5 = $null
+    foreach ($w in @(Get-JsonProp $Quota 'windows')) {
+        if ($null -eq $w) { continue }
+        if ([string]$w.w -ceq '7D') { $w7 = $w } elseif ([string]$w.w -ceq '5H') { $w5 = $w }
+    }
+    $l7 = 0.0; $l5 = 0.0
+    if ($null -eq $w7 -or $null -eq $w5 -or -not [double]::TryParse([string]$w7.left, [System.Globalization.NumberStyles]::Float, [cultureinfo]::InvariantCulture, [ref]$l7) -or
+        -not [double]::TryParse([string]$w5.left, [System.Globalization.NumberStyles]::Float, [cultureinfo]::InvariantCulture, [ref]$l5)) { $r.Why = 'нема вікна 5H чи 7D'; return $r }
+    $reset7 = ConvertTo-UtcSeconds $w7.reset; $reset5 = ConvertTo-UtcSeconds $w5.reset
+    if ($null -eq $reset7 -or $reset7 -le $Now -or ($null -ne $reset5 -and $reset5 -le $Now)) { $r.Why = 'вікно вже скинулось — дані минулого вікна'; return $r }
+    $week = 7 * 86400
+    $r.Known = $true; $r.Probe = $false
+    $r.Used7 = [Math]::Round((100 - $l7) / 100, 4)
+    $r.Pace7 = [Math]::Round([Math]::Min(1.0, [Math]::Max(0.0, ($Now - ($reset7 - $week)) / $week)), 4)
+    $r.Left5 = $l5
+    if ($r.Used7 -gt $r.Pace7) { $r.Why = '7D випереджає рівний темп'; return $r }
+    if ($l5 -lt $reserve) { $r.Why = "5H нижче запасу $reserve %"; return $r }
+    $r.Take = $true; $r.Why = 'темп дозволяє'
+    $r
+}
+
+function Test-ClaudeStart($Pace, [int]$Running) {
+    <# Чи можна взяти ще одну нову позначку смуги Claude. $null — темп вимкнено (`claude_pace` 0): лише стеля слотів. #>
+    if ($null -eq $Pace) { return $true }
+    if ($Pace.Take) { return $true }
+    $Pace.Probe -and $Running -eq 0
+}
