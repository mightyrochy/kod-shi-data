+            $n++; $started++
+        }
+        $started
+    }
+    $cases = @(
+        @{ Id = 'а'; Name = '7D позаду темпу (використано 30 % < 50 %), 5H з запасом (70 %)'; Quota = (New-Quota 70 70); Running = 0; Do = 2; After = 3 }
