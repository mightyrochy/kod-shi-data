+        @{ Id = 'б2'; Name = '7D випереджає темп, наряд уже йде — не зупиняється, нового нема'; Quota = (New-Quota 20 70); Running = 1; Do = 1; After = 0 }
+        @{ Id = 'в'; Name = '5H нижче запасу (залишок 10 % < 20 %)'; Quota = (New-Quota 70 10); Running = 0; Do = 2; After = 0 }
+        @{ Id = 'г'; Name = 'даних нема'; Quota = $null; Running = 0; Do = 2; After = 1 }
+        @{ Id = 'г2'; Name = 'дані старші за 30 хв'; Quota = (New-Quota 70 70 7200); Running = 0; Do = 2; After = 1 }
+        @{ Id = 'г3'; Name = 'даних нема, але проба вже йде'; Quota = $null; Running = 1; Do = 1; After = 0 }
+        @{ Id = 'г4'; Name = 'вікно 7D уже скинулось (дані минулого вікна)'; Quota = (New-Quota 70 70 60 ($now - 100)); Running = 0; Do = 2; After = 1 }
+    )
+    "| випадок | ДО (стеля 2, будь-який темп) | ПІСЛЯ (стеля $ceiling, темп) |"
+    foreach ($c in $cases) {
+        Scenario "випадок $($c.Id)" {
+            $pace = Get-ClaudePace $c.Quota $limits $now
+            $after = Get-Started $pace $c.Running
+            "| $($c.Id) $($c.Name) | $($c.Do) | $after (причина: $($pace.Why)) |"
+            Check "$($c.Id) $($c.Name): бере $($c.After)" ($after -eq $c.After)
+        }
+    }
+    Scenario 'межа темпу' {
+        $p = Get-ClaudePace (New-Quota 50 70) $limits $now
+        Check 'рівно на темпі (використано 50 % = рівний темп 50 %) — бере' ($p.Take -and $p.Used7 -eq 0.5 -and $p.Pace7 -eq 0.5)
+        $p = Get-ClaudePace (New-Quota 49 70) $limits $now
+        Check 'трохи випереджає темп — не бере' (-not $p.Take -and $p.Known)
+        $p = Get-ClaudePace (New-Quota 70 20) $limits $now
+        Check 'залишок 5H рівно на запасі — бере' $p.Take
+    }
+    Scenario 'темп для тіла #1856' {
+        $p = Get-ClaudePace (New-Quota 70 70) $limits $now
+        Check 'використано, темп і залишок 5H доступні' ($p.Known -and $p.Used7 -eq 0.3 -and $p.Pace7 -eq 0.5 -and $p.Left5 -eq 70)
+    }
+    Scenario 'темп вимкнено' {
