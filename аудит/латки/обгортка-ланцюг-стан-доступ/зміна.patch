+    [DllImport("advapi32.dll", SetLastError=true)] static extern bool CreateRestrictedToken(IntPtr token,uint flags,uint nd,IntPtr disable,uint np,IntPtr priv,uint nr,ref SidAttr restrict,out IntPtr result);
