+    function Invoke-RestMethod { throw 'сервер недоступний' }
+    Check 'недоступний сервер лишає очікування' (-not [bool](& $script:RealModelsCheck $cfg))
+    # Шаблони планувальників: повний SHA, ніякого вільного тексту з API.
