+"${PWSH:-pwsh}" -NoProfile -File "$(wp "$H/сценарії_ланцюга.ps1")"
diff --git a/аудит/адаптери/gemini/перевірка/сценарії_самооновлення.ps1 b/аудит/адаптери/gemini/перевірка/сценарії_самооновлення.ps1
