+    <# Один результат стенда, без прихованих відмов. #>
+    if ($Ok) { "✓ $Name" } else { "✗ $Name"; $script:failures++ }
+}
+try {
+    $seed = Join-Path $tmpRoot 'seed'; $remote = Join-Path $tmpRoot 'origin.git'
