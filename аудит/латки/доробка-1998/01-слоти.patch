+        $n -ge $script:Ceil.slots[0] -and $n -le $script:Ceil.slots[1]
+}
+
+function Test-SlotName([string]$Name, [string[]]$Lanes = @($script:LaneDefaults.Keys)) {
+    <# Назва слота дозволеної смуги з додатним номером у спільному діапазоні.
