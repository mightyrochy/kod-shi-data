+        $matches = @(Get-Markers | Where-Object { $_.Valid -and $_.Name -ceq $request.queue -and $_.Sha -ceq $request.marker -and $script:Lanes -contains $_.Lane })
+        if ($matches.Count -ne 1) { continue }
+        $m = $matches[0]; $key = Get-MarkerKey $m
