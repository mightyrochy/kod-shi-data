+            head=@{ref=$Branch;sha=$Head;repo=@{full_name=$GitHubRepo}};base=@{ref='main';repo=@{full_name=$GitHubRepo}}}
+    }
+    function Tick([string]$Head, [string]$Branch='claude/5.3-повний-обхід') {
