+        $replacement = $item.line
+        if ($item.error) { $replacement = "Вадний рядок живого прогону: $($item.error); оригінал: $($item.line)" }
+        $lines.RemoveRange($item.first, $item.last - $item.first + 1)
+        $lines.Insert($item.first, $replacement)
+    }
