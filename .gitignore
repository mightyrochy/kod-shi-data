# Розпакований каталог: у репозиторії лежить каталог_повний.xml.gz, а стенд
# розпаковує його сам. 44 МБ, які відновлюються за секунду, у git не тримаємо.
джерела/каталог_повний.xml

# Кеш вимірів кольору: похідне від каталогу, відновлюється прогоном.
джерела/стенд_кеш_кольорів.json
джерела/кеш_кольорів.json

# Знімки стенда: робочі файли порівняння, а не джерело.
джерела/стенд_*.json
!джерела/стенд_вх.json

__pycache__/
*.pyc
