# Розпакований каталог: у репозиторії лежить каталог_повний.xml.gz, а стенд
# розпаковує його сам. 44 МБ, які відновлюються за секунду, у git не тримаємо.
джерела/каталог_повний.xml

# Кеш вимірів кольору: похідне від каталогу, відновлюється прогоном.
джерела/стенд_кеш_кольорів.json
джерела/кеш_кольорів.json

# Знімки стенда: робочі файли порівняння, а не джерело.
джерела/стенд_*.json
!джерела/стенд_вх.json

__pycache__/
*.pyc

# Фікстура гейтів: у git лежить каталог_brief.xml.gz (261 КБ),
# feed.каталог_на_диску розпаковує її сам за потреби.
джерела/каталог_brief.xml

# Робочі теки мутаційного приладу. `$Д` — слід нерозкритої змінної оболонки:
# 110 симлінків з АБСОЛЮТНИМИ шляхами потрапили в коміт b2b1396 і на будь-якій
# іншій машині були б мертві. Ловимо шаблоном, а не пам'яттю.
джерела/$*/
джерела/зріз_мутанта*/

# Залежності jsdom-батареї показу. Приймальна команда Н-V01-003 ставить їх
# рівно тут: `cd джерела && npm i jsdom fake-indexeddb`. Це кеш npm (десятки
# МБ), а не джерело; build_артефакт._тест_показу лише перевіряє, що тека є.
джерела/node_modules/
джерела/package.json
джерела/package-lock.json
