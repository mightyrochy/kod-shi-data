  "actualSuffix": "const секунд = Math.round((Date.now()-почато)/1000);\n    ЗБ.картки.filter(к => к && !к.збій && (к.рука === '1' || к.рука === '2'))\n.forEach(к => (к.речі || []).forEach(р => { if (р && р.id && !р.вигадана) ВЖЕ_БУЛИ_П.add(р.id); }));\n    const зп = $('зб-поступ'); if (зп) зп.textContent = 'готово за ' + секунд + ' с · діагнозів: ' + ЗБ.діагноз.length;\nawait записатиЗбоїРукП();\nconst усіЗбій = !ЗБ.картки.some(к=>к && !к.збій);\n    if (усіЗбій) throw new Error('build_no_hand_finished: ' + (ЗБ.діагноз[ЗБ.діагноз.length-1] || 'no_reason'));\nрендер();\nЗБ.успіх = true; ЗБ.готово = true; малюватиПоступП(); малюватиДіагнозП();\n}catch(e){\nconsole.error(e);\n    режим('сценарій');\n    ст.textContent = ''; оголоситиВідмовуЗбиранняП(ст.textContent);\nif (ЗБ){\n      ЗБ.діагноз.push('build · failed: ' + String((e && e.stack) || e).slice(0, 1200));\nмалюватиПоступП(); малюватиДіагнозП();\n}\n    const м = await повідомленнямП({відмова: повідомленняЗбоюЗбиранняП(e)}, 'build');\nif (ЗБ){ ЗБ.діагноз.push(...рядкиШаруП(м.записи)); малюватиДіагнозП(); }\n    ст.textContent = м.тексти.відмова || '';\nоголоситиВідмовуЗбиранняП(ст.textContent);\n}finally{ кн.disabled = false; далі.disabled = false; }\n",
