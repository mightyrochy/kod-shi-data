        "content": "{\"rows\": [{\"row_id\": \"70538d581f339f3cf6f6db5f0355afdb8d5f885284dc450de64b918682d196fa\", \"raw\": \"Айворі, Бежевий,\"}, {\"row_id\": \"6c1bf3ce4136a4780cd148f0dff5712a6721677bb33483f2ec088294fa82afc6\", \"raw\": \"Айворі, Бежевий, Білий, Волошка, Капучіно, Марсала, Рожевий, темно бузковий, Чорний, Шавлія\"}, {\"row_id\": \"041a1e367af2bed4f071e473c67e1d92ca2a13b87824328442174e8563dc3b73\", \"raw\": \"Айворі, Капучіно,\"}, {\"row_id\": \"280849b7a0f5b187a53f6a3bfc1159cacc5ecf52f7a8451e5ffcc6d888eb3ce0\", \"raw\": \"Айворі, Капучіно, Хакі, Чорний\"}]}"
